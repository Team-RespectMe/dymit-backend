<?xml version="1.0" encoding="UTF-8" ?>

<configuration>
    <!--
      Spring Boot resolves these from application.yaml automatically.
      Do not duplicate the desired log level in this file.
    -->
    <property scope="context" name="PLATFORM" value="${PLATFORM_NAME:-unknown}" />
    <property scope="context" name="SERVICE" value="${SERVICE_NAME:-unknown}" />

    <!-- 쿠버네티스 관련 -->
    <property scope="context" name="K8S_NAMESPACE" value="${K8S_NAMESPACE:-unknown}" />
    <property scope="context" name="K8S_POD_NAME" value="${K8S_POD_NAME:-unknown}" />
    <property scope="context" name="K8S_POD_UID" value="${K8S_POD_UID:-unknown}" />
    <property scope="context" name="K8S_NODE_NAME" value="${K8S_NODE_NAME:-unknown}" />
    <property scope="context" name="LOG_FILE_PATH" value="${LOG_FILE_PATH:-/var/log/application.log}" />
    <property scope="context" name="LOG_ARCHIVE_FILE_PATTERN" value="${LOG_ARCHIVE_FILE_PATTERN:-/var/log/application.%d{yyyy-MM-dd}.%i.log.gz}" />

    <springProperty scope="context" name="ROOT_LOG_LEVEL" source="logging.level.root" defaultValue="INFO" />
    <springProperty scope="context" name="SPRING_LOG_LEVEL" source="logging.level.org.springframework" defaultValue="INFO" />
    <springProperty scope="context" name="HIBERNATE_LOG_LEVEL" source="logging.level.org.hibernate" defaultValue="WARN" />

    <include resource="console-appender.xml" />
    <include resource="file-appender.xml" />

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Reduce framework noise without hiding application logs. -->
    <logger name="org.springframework" level="${SPRING_LOG_LEVEL}" />
    <logger name="org.hibernate" level="${HIBERNATE_LOG_LEVEL}" />
</configuration>